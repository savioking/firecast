<?xml version="1.0" encoding="UTF-8"?>
<form name="frmPrincipal" align="client" theme="dark">
    <image name="bgImg" align="client" style="autoFit"/>
    <scrollBox align="client">
        <!-- Botão de Configuração -->
        <image name="configImg" url="/assets/components/cog.png" width="25" height="25" left="5" top="5" style="autoFit" cursor="handPoint"/>
        <button name="configBtn" left="5" top="5" width="25" height="25" cursor="handPoint" opacity="0.0">
            <event name="onClick">
                local pop = self:findControlByName("popConfig");
                local popConfig = self:findControlByName("configBtn");
                
                if pop ~= nil then
                    pop:setNodeObject(self.sheet);
                    pop:show("bottomCenter", popConfig);
                else
                    showMessage("Não foi encontrada a janela de seleção de configs.");
                end;
            </event>
        </button>

        <popup name="popConfig" width="375" height="360" backOpacity="0.4" autoScopeNode="true">			
            <flowLayout align="top" autoHeight="true" maxControlsPerLine="2" margins="{bottom=4}" horzAlign="center">						
                <comboBox align="top" items="{'Padrão', 'Numenera 1', 'Numenera 2', 'Fantasia 1', 'Fantasia 2', 'Steampunk 1', 'Steampunk 2',
                'Cyberpunk 1', 'Cyberpunk 2', 'Contemporâneo 1', 'Contemporâneo 2'}"
                
                values="{'default', 'numenera1', 'numenera2', 'fantasy1', 'fantasy2', 'steampunk1', 'steampunk2',
                'cyberpunk1', 'cyberpunk2', 'contemporaneo1', 'contemporaneo2'}"

                field="fundoPreviewCombobox" value="default" width="200" height="30"/>
                
                <image name="fundoPreview" width="320" height="180" align="top" style="autoFit" margins="{top=10}"/>
                <label align="top" text="URL Customizada:" width="200" height="30" horzTextAlign="center"/>
                
                <edit align="top" field="fundoPreviewURLCustomizada" width="200" height="30"/>
                
                <!-- APLICA A IMAGEM ESCOLHIDA/URL -->
                <button align="top" text="Aplicar" width="200" height="30" margins="{top=10}">
                    <event name="onClick">
                        if sheet.fundoPreviewCombobox ~= nil and sheet.fundoPreviewCombobox ~= "" then
                            self.bgImg.src = self.fundoPreview.src;
                            self.bgImgHab.src = self.fundoPreview.src;
                            self.bgImgDet.src = self.fundoPreview.src;

                            sheet.bgCustomURL = self.fundoPreview.src;
                        end;
                    
                        self.popConfig:close();
                    </event>
                </button>
                
                <button align="top" text="Aplicar URL" width="200" height="30">
                    <event name="onClick">
                        if sheet.fundoPreviewURLCustomizada ~= nil and sheet.fundoPreviewURLCustomizada ~= "" then
                            self.bgImg.src = sheet.fundoPreviewURLCustomizada;
                            self.bgImgHab.src = sheet.fundoPreviewURLCustomizada;
                            self.bgImgDet.src = sheet.fundoPreviewURLCustomizada;

                            sheet.bgCustomURL = sheet.fundoPreviewURLCustomizada;
                        end;
                    
                        self.popConfig:close();
                    </event>
                </button>
                
                <!-- MUDA A IMAGEM DO PREVIEW -->
                <dataLink field="fundoPreviewCombobox">
                    <event name="onChange">
                        self.fundoPreview.src = "/assets/bg/" .. (sheet.fundoPreviewCombobox or "default") .. ".jpg";
                    </event>
                </dataLink>
            </flowLayout>
        </popup>

        <layout g="container" g-cnt-gutter="20" g-cnt-line-spacing="20" margins="{top=20, bottom=20}">
            
            <!-- HEADER: FRASE DO PERSONAGEM, TIER, XP, ESFORÇO & JOGADOR -->
            <layout g="row" g-auto-height="true" g-cnt-horz-align="center" g-cnt-vert-align="center">
                <image src="/assets/components/logo_w_b_border.png" height="150"  g-role="col" g-width="6" g-width-sm="2" style="autoFit"/>
                
                <rectangle g="col" g-auto-height="true" g-width="12" g-width-sm="10" color="#211f1e" cornerType="bevel" xradius="20" yradius="25" g-cnt-line-spacing="10" padding="{left = 20, right = 20, top = 10, bottom = 10}" strokeColor="white" strokeSize="2">
                    <!-- Linha 1 da Frase: NOME + É UM(A) + DESCRITOR -->
                    <layout g="row" g-cnt-line-spacing="10" g-cnt-vert-align="center" g-cnt-gutter="5">
                        <edit name="charName" field="charName" g="col" g-width="12" g-width-sm="5" horzTextAlign="center" vertTextAlign="center" transparent="true" fontSize="22" textPrompt="Nome do Personagem">
                            <horzLine strokeColor="white" align="bottom"/>
                        </edit>
                        <label text="É UM(A)" g="col" g-width="12" g-width-sm="2" horzTextAlign="center" vertTextAlign="center" fontSize="16" fontStyle="bold" fontColor="#cccccc"/>
                        <edit name="charDesc" field="charDesc" g="col" g-width="12" g-width-sm="5" horzTextAlign="center" vertTextAlign="center" transparent="true" fontSize="22" textPrompt="Descritor / Espécie">
                            <horzLine strokeColor="white" align="bottom"/>
                        </edit>
                    </layout>

                    <!-- Linha 2 da Frase: TIPO + QUE + FOCO -->
                    <layout g="row" g-cnt-line-spacing="10" g-min-height="50" g-cnt-vert-align="center" g-cnt-gutter="5">
                        <edit name="charType" field="charType" g="col" g-width="12" g-width-sm="5" horzTextAlign="center" vertTextAlign="center" transparent="true" fontSize="22" textPrompt="Tipo">
                            <horzLine strokeColor="white" align="bottom"/>
                        </edit>
                        <label text="QUE" g="col" g-width="12" g-width-sm="2" horzTextAlign="center" vertTextAlign="center" fontSize="16" fontStyle="bold" fontColor="#cccccc"/>
                        <edit name="charFoci" field="charFoci" g="col" g-width="12" g-width-sm="5" horzTextAlign="center" vertTextAlign="center" transparent="true" fontSize="22" textPrompt="Foco">
                            <horzLine strokeColor="white" align="bottom"/>
                        </edit>
                    </layout>

                    <!-- Linha 3: Tier, XP, Esforço e Jogador -->
                    <layout g="row" g-cnt-line-spacing="10" g-min-height="40" g-cnt-vert-align="center" g-cnt-gutter="6" margins="{top=5}">
                        <label text="Tier:" g="col" g-width="2" g-width-sm="1" horzTextAlign="trailing" vertTextAlign="center" fontSize="16" fontStyle="bold"/>
                        <edit name="charTier" field="charTier" g="col" g-width="2" g-width-sm="1" horzTextAlign="center" vertTextAlign="center" fontSize="18" type="number"/>

                        <label text="XP:" g="col" g-width="2" g-width-sm="1" horzTextAlign="trailing" vertTextAlign="center" fontSize="16" fontStyle="bold"/>
                        <edit name="charXP" field="charXP" g="col" g-width="2" g-width-sm="1" horzTextAlign="center" vertTextAlign="center" fontSize="18" type="number"/>

                        <label text="Esforço:" g="col" g-width="2" g-width-sm="1" horzTextAlign="trailing" vertTextAlign="center" fontSize="16" fontStyle="bold"/>
                        <edit name="charEffort" field="charEffort" g="col" g-width="2" g-width-sm="1" horzTextAlign="center" vertTextAlign="center" fontSize="18" type="number"/>

                        <layout g="col" g-width="1" g-width-sm="1"/>

                        <label text="Jogador:" g="col" g-width="5" g-width-sm="2" horzTextAlign="trailing" vertTextAlign="center" fontSize="16" fontStyle="bold"/>
                        <edit name="charPlayer" field="charPlayer" g="col" g-width="6" g-width-sm="3" horzTextAlign="center" vertTextAlign="center" transparent="true" fontSize="18" textPrompt="Nome do Jogador">
                            <horzLine strokeColor="white" align="bottom"/>
                        </edit>
                    </layout>
                </rectangle>
            </layout>

            <!-- PAINEL CONJUNTO: RESERVAS, FERIMENTOS E RECUPERAÇÃO (ESQUERDA) + FOTO E ANOTAÇÕES (DIREITA) -->
            <layout g="row" g-auto-height="true" g-cnt-gutter="20" g-cnt-line-spacing="15">

                <!-- COLUNA ESQUERDA: RESERVAS, FERIMENTOS & RECUPERAÇÃO (g-width="12" g-width-md="8") -->
                <layout g="col" g-width="12" g-auto-height="true" g-width-sm="8" g-vert-tile="true" g-cnt-line-spacing="15">

                    <!-- BLOCO 1: RESERVAS DE ATRIBUTOS (POOLS) -->
                    <rectangle g="row" g-auto-height="true" color="#211f1e" cornerType="bevel" xradius="20" yradius="25" padding="{left = 15, right = 15, top = 10, bottom = 10}" strokeColor="white" strokeSize="2">
                        <label text="RESERVAS" g="row"  g-min-height="40" horzTextAlign="center" fontSize="16" fontStyle="bold" fontColor="#ffffff"/>
                        
                        <layout g="row" g-auto-height="true" g-cnt-gutter="10">
                            <!-- POTÊNCIA (MIGHT) -->
                            <rectangle g="col" g-auto-height="true" g-width="12" g-width-sm="4" color="#181716" strokeColor="#555555" strokeSize="1" cornerType="bevel" xradius="10" yradius="10" padding="{left=5, right=5, top=5, bottom=5}">
                                <label text="POTÊNCIA" g="row" g-min-height="30" horzTextAlign="center" fontStyle="bold" fontSize="13" fontColor="#ff8888"/>
                                <layout g-auto-height="true" g="row" g-cnt-line-spacing="10">
                                    <label text="Valor:" g="col" g-width="2" horzTextAlign="trailing" g-width-sm="3" fontSize="14" g-vert-tile="true" vertTextAlign="center"/>
                                    <edit field="potCur" type="number" g="col" g-width="2" g-width-sm="4" horzTextAlign="center" fontSize="16"/>
                                    <rectangle color="#555555" g="block" width="2" g-vert-tile="true"/>
                                    <edit field="potMax" type="number" g="col" g-width="2" g-width-sm="4" horzTextAlign="center" fontSize="16"/>
                                    <label text="Edge:" g="col" g-width="2" horzTextAlign="trailing" g-width-sm="3" fontSize="14" g-vert-tile="true"/>
                                    <edit field="potEdge" g="col" g-width="2" g-width-sm="4" type="number" horzTextAlign="center" fontSize="16"/>
                                </layout>
                            </rectangle>

                            <!-- VELOCIDADE (SPEED) -->
                            <rectangle g="col" g-auto-height="true" g-width="12" g-width-sm="4" color="#181716" strokeColor="#555555" strokeSize="1" cornerType="bevel" xradius="10" yradius="10" padding="{left=5, right=5, top=5, bottom=5}">
                                <label text="VELOCIDADE" g="row" g-min-height="30" horzTextAlign="center" fontStyle="bold" fontSize="13" fontColor="#88ff88"/>
                                <layout g-auto-height="true" g="row" g-cnt-line-spacing="10">
                                    <label text="Valor:" g="col" g-width="2" horzTextAlign="trailing" g-width-sm="3" fontSize="14" g-vert-tile="true" vertTextAlign="center"/>
                                    <edit field="velCur" type="number" g="col" g-width="2" g-width-sm="4" horzTextAlign="center" fontSize="16"/>
                                    <rectangle color="#555555" g="block" width="2" g-vert-tile="true"/>
                                    <edit field="velMax" type="number" g="col" g-width="2" g-width-sm="4" horzTextAlign="center" fontSize="16"/>
                                    <label text="Edge:" g="col" g-width="2" horzTextAlign="trailing" g-width-sm="3" fontSize="14" g-vert-tile="true"/>
                                    <edit field="velEdge" g="col" g-width="2" g-width-sm="4" type="number" horzTextAlign="center" fontSize="16"/>
                                </layout>
                            </rectangle>

                            <!-- INTELECTO (INTELLECT) -->
                            <rectangle g="col" g-auto-height="true" g-width="12" g-width-sm="4" color="#181716" strokeColor="#555555" strokeSize="1" cornerType="bevel" xradius="10" yradius="10" padding="{left=5, right=5, top=5, bottom=5}">
                                <label text="INTELECTO" g="row" g-min-height="30" horzTextAlign="center" fontStyle="bold" fontSize="13" fontColor="#8888ff"/>
                                <layout g-auto-height="true" g="row" g-cnt-line-spacing="10">
                                    <label text="Valor:" g="col" g-width="2" horzTextAlign="trailing" g-width-sm="3" fontSize="14" g-vert-tile="true" vertTextAlign="center"/>
                                    <edit field="intCur" type="number" g="col" g-width="2" g-width-sm="4" horzTextAlign="center" fontSize="16"/>
                                    <rectangle color="#555555" g="block" width="2" g-vert-tile="true"/>
                                    <edit field="intMax" type="number" g="col" g-width="2" g-width-sm="4" horzTextAlign="center" fontSize="16"/>
                                    <label text="Edge:" g="col" g-width="2" horzTextAlign="trailing" g-width-sm="3" fontSize="14" g-vert-tile="true"/>
                                    <edit field="intEdge" g="col" g-width="2" g-width-sm="4" type="number" horzTextAlign="center" fontSize="16"/>
                                </layout>
                            </rectangle>
                        </layout>
                    </rectangle>

                    <!-- BLOCO 2 & 3: FERIMENTOS E RECUPERAÇÃO NA MESMA LINHA EM TELAS MAIORES -->
                    <layout g="row" g-auto-height="true" g-cnt-gutter="15" g-cnt-line-spacing="15">
                        
                        <!-- FERIMENTOS (g-width="12" g-width-sm="6") -->
                        <rectangle g="col" g-width="12" g-width-sm="6" g-auto-height="true" color="#211f1e" cornerType="bevel" xradius="20" yradius="25" padding="{left = 12, right = 12, top = 8, bottom = 8}" strokeColor="white" strokeSize="2">
                            <label text="FERIMENTOS" g="row" g-min-height="40" horzTextAlign="center" fontSize="15" fontStyle="bold"/>
                            
                            <!-- Leves (Minor) -->
                            <layout g="row" g-auto-height="true" g-cnt-gutter="10">
                                <label text="LEVES:" g="col" g-width="3" horzTextAlign="trailing" vertTextAlign="center" fontSize="14" fontStyle="bold"/>
                                <layout g="col" g-width="9" >
                                    <imageCheckBox field="woundMinor1" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMinor2" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMinor3" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMinor4" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMinor5" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMinor6" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                </layout>
                            </layout>

                            <!-- Médias (Moderate) -->
                            <layout g="row" g-auto-height="true" g-cnt-gutter="10">
                                <label text="MÉDIAS:" g="col" g-width="3" horzTextAlign="trailing" vertTextAlign="center" fontSize="14" fontStyle="bold" fontColor="#ffcc00"/>
                                <layout g="col" g-width="9" >
                                    <imageCheckBox field="woundMod1" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMod2" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMod3" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMod4" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMod5" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <imageCheckBox field="woundMod6" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                </layout>
                            </layout>

                            <!-- Graves (Major) -->
                            <layout g="row" g-auto-height="true" g-cnt-gutter="10">
                                <label text="GRAVES:" g="col" g-width="3" horzTextAlign="trailing" vertTextAlign="center" fontSize="14" fontStyle="bold" fontColor="#ff5555"/>
                                <layout g="col" g-width="9" >
                                    <imageCheckBox field="woundMajor1" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png" hint="Grave 1"/>
                                    <imageCheckBox field="woundMajor2" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png" hint="Grave 2"/>
                                    <imageCheckBox field="woundMajorDead" g="block" width="22" height="22" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png" hint="Morte"/>
                                </layout>
                            </layout>
                        </rectangle>

                        <!-- RECUPERAÇÃO (g-width="12" g-width-sm="6") -->
                        <rectangle g="col" g-width="12" g-width-sm="6" g-auto-height="true" color="#211f1e" cornerType="bevel" xradius="20" yradius="25" padding="{left = 12, right = 12, top = 8, bottom = 20}" strokeColor="white" strokeSize="2" g-cnt-line-spacing="10">
                            <label text="RECUPERAÇÃO" g="row" g-min-height="40" horzTextAlign="center" fontSize="15" fontStyle="bold"/>
                            
                            <!-- Rolagem 1d6 + Bonus -->
                            <layout g="row" g-auto-height="true" g-cnt-gutter="10" g-cnt-horz-align="center">
                                <label text="1d6 + Tier +" g="col" g-width="3" g-vert-tile="true" fontSize="16" horzTextAlign="trailing"/>
                                <edit field="recoveryBonus" g="col" g-width="1" textPrompt="Tier" fontSize="16" horzTextAlign="center"/>
                                <button text="Rolar" g-vert-tile="true" g="col" g-width="2" cursor="handPoint">
                                    <event name="onClick">
                                        local mesa = Firecast.getMesaDe(self);
                                        local bonus = (tonumber(self.sheet.recoveryBonus) or 0) + (tonumber(self.sheet.charTier) or 0);
                                        local rolagem = "1d6";
                                        if bonus > 0 then
                                            rolagem = rolagem .. " + " .. bonus;
                                        elseif bonus &lt; 0 then
                                            rolagem = rolagem .. " - " .. math.abs(bonus);
                                        end;
                                        mesa.chat:rolarDados(rolagem, "Recuperação");
                                    </event>
                                </button>
                            </layout>

                            <layout g="row" g-min-height="1" />

                            <!-- Descansos Checkboxes -->
                            <layout g="row" g-auto-height="true" g-cnt-gutter="5" g-cnt-line-spacing="10" g-cnt-horz-align="center">
                                <layout g="col" g-width="5" g-auto-height="true">
                                    <imageCheckBox field="rec1Action" g="block" width="20" height="20" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <label text="1 Ação" g="col" g-width="12" height="20" fontSize="12"/>
                                </layout>
                                <layout g="col" g-width="5" g-auto-height="true">
                                    <imageCheckBox field="rec10Min" g="block" width="20" height="20" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <label text="10 Min." g="col" g-width="12" height="20" fontSize="12"/>
                                </layout>
                                <layout g="col" g-width="5" g-auto-height="true">
                                    <imageCheckBox field="rec1Hour" g="block" width="20" height="20" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <label text="1 Hora" g="col" g-width="12" height="20" fontSize="12"/>
                                </layout>
                                <layout g="col" g-width="5" g-auto-height="true">
                                    <imageCheckBox field="rec10Hrs" g="block" width="20" height="20" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <label text="10 Horas" g="col" g-width="12" height="20" fontSize="12"/>
                                </layout>
                            </layout>
                        </rectangle>

                        <!-- AVANÇOS (g-width="12" g-width-sm="6") -->
                        <rectangle g="col" g-width="12" g-width-sm="6" g-auto-height="true" color="#211f1e" cornerType="bevel" xradius="20" yradius="25" padding="{left = 12, right = 12, top = 8, bottom = 20}" strokeColor="white" strokeSize="2" g-cnt-line-spacing="10">
                            <label text="AVANÇOS" g="row" g-min-height="40" horzTextAlign="center" fontSize="15" fontStyle="bold"/>

                            <layout g="row" g-min-height="1" />

                            <!-- Descansos Checkboxes -->
                            <layout g="row" g-auto-height="true" g-cnt-gutter="5" g-cnt-line-spacing="10" g-cnt-horz-align="center">
                                <layout g="col" g-width="5" g-auto-height="true">
                                    <imageCheckBox field="rec1Action" g="block" width="20" height="20" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <label text="+4 nas Reservas" g="col" g-width="12" height="20" fontSize="12"/>
                                </layout>
                                <layout g="col" g-width="5" g-auto-height="true">
                                    <imageCheckBox field="rec10Min" g="block" width="20" height="20" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <label text="+1 Perícia" g="col" g-width="12" height="20" fontSize="12"/>
                                </layout>
                                <layout g="col" g-width="5" g-auto-height="true">
                                    <imageCheckBox field="rec1Hour" g="block" width="20" height="20" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <label text="+1 de Esforço" g="col" g-width="12" height="20" fontSize="12"/>
                                </layout>
                                <layout g="col" g-width="5" g-auto-height="true">
                                    <imageCheckBox field="rec10Hrs" g="block" width="20" height="20" checkedImage="/assets/components/checkbox1_checked.png" uncheckedImage="/assets/components/checkbox1_unchecked.png"/>
                                    <label text="+1 em Edge" g="col" g-width="12" height="20" fontSize="12"/>
                                </layout>
                            </layout>
                        </rectangle>

                    </layout>

                </layout>

                <!-- COLUNA DIREITA: FOTO E ANOTAÇÕES (g-width="12" g-width-md="4") -->
                <layout g="col" g-width="12" g-auto-height="true" g-width-sm="4" g-vert-tile="true" g-cnt-line-spacing="15">
                    
                    <!-- IMAGEM DO PERSONAGEM -->
                    <rectangle g="row" g-min-height="300" color="#211f1e" padding="{left = 2, right = 2, top = 2, bottom = 2}" strokeColor="white" strokeSize="2">
                        <image align="client" style="autoFit" field="charImage" editable="true" animate="true"/>
                    </rectangle>

                    <!-- ANOTAÇÕES RÁPIDAS -->
                    <rectangle g="row" g-min-height="300" g-vert-tile="true" color="#211f1e" cornerType="bevel" xradius="20" yradius="25" padding="{left = 12, right = 12, top = 10, bottom = 10}" strokeColor="white" strokeSize="2">
                        <label text="ANOTAÇÕES RÁPIDAS" align="top" height="25" horzTextAlign="center" fontSize="16" fontStyle="bold"/>
                        <richEdit align="client" field="anotacoesPrincipais" defaultFontColor="white" defaultFontSize="14" backgroundColor="#181716" showToolbar="false"/>
                    </rectangle>

                </layout>

            </layout>
        </layout>
    </scrollBox>
</form>